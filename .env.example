PORT=3333

# Required for live data
KAPTURE_BASE_URL=https://your-kapture-host.example.com
KAPTURE_AUTH_PREFIX=Basic
KAPTURE_LIST_AUTH_TOKEN=replace-with-basic-token-without-prefix

# Optional. Defaults to the known date-range endpoint.
KAPTURE_TICKET_LIST_ENDPOINT=/select-ticket-between-start-and-end-dates.html/v.2.0
KAPTURE_COOKIE=

# Exact Kapture date-range payload settings.
KAPTURE_PAYLOAD_STYLE=kapture-array
KAPTURE_FETCH_STATUSES=P,C
KAPTURE_PAGE_LIMIT=500
KAPTURE_PAGE_CONCURRENCY=12
KAPTURE_PERFORMANCE_TIMEOUT_MS=5000
KAPTURE_FAST_COMPLETED_LOOKBACK_DAYS=21
KAPTURE_COMPLETED_LOOKBACK_DAYS=60
KAPTURE_PERFORMANCE_TOTALS=1
KAPTURE_DASHBOARD_AGENT_IDS=
KAPTURE_DASHBOARD_COOKIE=

# Optional request tuning if your Kapture tenant expects different names.
# KAPTURE_HTTP_METHOD=POST
# KAPTURE_AUTH_HEADER=Authorization
# KAPTURE_START_DATE_PARAM=startDate
# KAPTURE_END_DATE_PARAM=endDate
# KAPTURE_DATE_VALUE_MODE=date
# KAPTURE_EXTRA_HEADERS={"x-custom-header":"value"}
