<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kapture.live-dashboard.ui.watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/obulappagari.naveen/.kapture-live-dashboard/scripts/watch-dashboard.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>3335</string>
    <key>DASHBOARD_HOST</key>
    <string>127.0.0.1</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/obulappagari.naveen/.kapture-live-dashboard</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/tmp/kapture-live-dashboard-ui-watch.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/kapture-live-dashboard-ui-watch.err.log</string>
</dict>
</plist>
